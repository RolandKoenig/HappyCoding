<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="local-application"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HappyCoding.AvaloniaGlobalExceptionHandling.MainWindow"
        x:DataType="app:MainWindowViewModel"
        Title="HappyCoding.AvaloniaGlobalExceptionHandling">
    <Window.DataContext>
        <app:MainWindowViewModel />
    </Window.DataContext>
    
    <Window.Styles>
        <Style Selector="Border.ButtonArea">
            <Setter Property="Background" Value="#88888888" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            
            <Style Selector="^ StackPanel">
                <Setter Property="Spacing" Value="10" />
            </Style>
            <Style Selector="^ Button">
                <Setter Property="Width" Value="400"></Setter>
            </Style>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Styles>
    
    <Grid>
        <Border Classes="ButtonArea"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Vertical">
                <Button Content="Throw exception in synchronous code"
                        Command="{Binding ThrowExceptionInSynchronousCodeCommand}" />
                <Button Content="Throw exception in asynchronous code"
                        Command="{Binding ThrowExceptionInAsynchronousCodeCommand}" />
                <Button Content="Throw exception in async void method"
                        Command="{Binding ThrowExceptionInAsyncVoidMethodAsyncCommand}" />
                <Button Content="Throw exception in background task"
                        Command="{Binding ThrowExceptionInBackgroundTaskCommand}" />
                <Button Content="Throw exception in ThreadPool"
                        Command="{Binding ThrowExceptionInThreadPoolCommand}" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
