<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="local-application">
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="20">
                <l:ToggleLabel LabelText="Dummy label" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    
    <ControlTheme x:Key="{x:Type l:ToggleLabel}" TargetType="l:ToggleLabel">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="PART_ToggleButton" 
                                Content="Toggle me"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{TemplateBinding LabelText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
